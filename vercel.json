{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm --prefix muteachers install",
  "buildCommand": "npm --prefix muteachers run build",
  "outputDirectory": "muteachers/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/c/:slug",
      "destination": "/api/card-preview?slug=:slug"
    },
    {
      "source": "/card/:slug",
      "destination": "/api/card-preview?slug=:slug"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
